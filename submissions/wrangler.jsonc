{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accessible-learning-submissions",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "preview_urls": true,
  "r2_buckets": [
    {
      "binding": "SUBMISSIONS_BUCKET",
      "bucket_name": "accessible-learning-submissions"
    }
  ]
}
